{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zippopotam Postal Code Response",
  "type": "object",
  "properties": {
    "post code": { "type": "string" },
    "country": { "type": "string" },
    "country abbreviation": { "type": "string" },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "place name": { "type": "string" },
          "longitude": { "type": "string" },
          "state": { "type": "string" },
          "state abbreviation": { "type": "string" },
          "latitude": { "type": "string" }
        },
        "required": ["place name", "longitude", "state", "state abbreviation", "latitude"],
        "additionalProperties": false
      }
    }
  },
  "required": ["post code", "country", "country abbreviation", "places"],
  "additionalProperties": false
}